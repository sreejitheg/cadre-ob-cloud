{
  "custom": {},
  "params": {
    "deviceId": "",
    "deviceKind": "sequence",
    "deviceLabel": "",
    "hasStep": false,
    "hasTag": true,
    "label": "",
    "step": 0,
    "tag": "",
    "text": ""
  },
  "propConfig": {
    "params.deviceId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.deviceKind": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.deviceLabel": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.hasStep": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.hasTag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.step": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 72,
      "width": 144
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Tag"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.hasTag} && len({view.params.tag}) > 0, {view.params.tag}, {view.params.label})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "cadre/font/automation-label cadre/text/neutral cadre/text/ellipsis",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Text"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.text}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "cadre/font/instrument-value-regular-active cadre/text/active cadre/text/ellipsis",
            "lineHeight": "1",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Step"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.hasStep}"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "'Step ' + numberFormat({view.params.step}, '0')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "cadre/font/instrument-unit cadre/text/neutral",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tif self.view.params.deviceId:\n\t\tcadre.hmi.select_device(self.session, self.view.params.deviceId, self.view.params.deviceKind or 'sequence', self.view.params.tag or self.view.params.label, self.view.params.deviceLabel)\n\t\tif self.session.custom.faceplateMode == 'popup':\n\t\t\tif cadre.hmi.asm_frame(self.session):\n\t\t\t\tfid = cadre.hmi.float_id(self.session.custom.selectedDevice)\n\t\t\t\tsystem.perspective.closePopup(fid)\n\t\t\t\tsystem.perspective.openPopup(id=fid, view='Framework/ASM/FloatFaceplate', params=cadre.hmi.float_params(self.session, fid), title=self.session.custom.selectedTitle, position=cadre.hmi.float_position(self.session, self.session.custom.selectedDevice), showCloseIcon=True, draggable=True, resizable=True, modal=False, overlayDismiss=False, viewportBound=True)\n\t\t\telse:\n\t\t\t\tsystem.perspective.openPopup(id='faceplatePopup', view='Framework/FaceplatePopup', title=self.session.custom.selectedTitle, position={'top': 56, 'right': 16}, showCloseIcon=True, draggable=True, resizable=True, modal=False, overlayDismiss=False, viewportBound=True)\n\t\telse:\n\t\t\tsystem.perspective.openDock(id='faceplate')\n\t\t\tself.session.custom.faceplateDocked = True"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "alignItems": "stretch",
      "direction": "column",
      "justify": "center",
      "style": {
        "backgroundColor": "var(--container-global-color)",
        "border": "1px solid var(--automation-device-tertiary-color)",
        "borderRadius": "4px",
        "cursor": "pointer",
        "gap": "2px",
        "overflow": "hidden",
        "padding": "2px 6px"
      }
    },
    "type": "ia.container.flex"
  }
}
