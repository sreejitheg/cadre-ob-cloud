  "propConfig": {
    "custom.alarmCount": {
      "binding": {
        "config": {
          "expression": "if(toMillis(now(2000)) > 0, {view.params.deviceId}, '')"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.alarm_count(self.session.custom.alarmScope, cadre.hmi.device_sources(self.session, value))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.can": {
      "binding": {
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.permissions(self.session)",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.dev": {
      "binding": {
        "config": {
          "expression": "if(toMillis(now(1000)) > 0, {view.params.deviceId}, '')"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.device_read(self.session, value, ['state', 'mnt/forceOn', 'mnt/forceOff', 'mnt/forceMode', 'mnt/forceValue', 'mnt/errorMask', 'mnt/simulated', 'mnt/alarmSuppress', 'mnt/manualMode'])",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.source": {
      "binding": {
        "config": {
          "expression": "{view.params.deviceId}"
        },
        "transforms": [
          {
            "code": "\treturn ','.join(cadre.hmi.device_sources(self.session, value))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "params.deviceId": {
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.tab = 'status'\n\twant = self.params.tab\n\tif want in ('status', 'maintenance', 'alarms'):\n\t\tself.custom.tab = want\n\tself.custom.message = ''\n\tself.custom.pending = {'active': False, 'device': '', 'path': '', 'member': '', 'value': 0, 'text': ''}"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.tab": {
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.tab = 'status'\n\twant = currentValue.value\n\tif want in ('status', 'maintenance', 'alarms'):\n\t\tself.custom.tab = want"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 720,
      "width": 400
    }
  },
