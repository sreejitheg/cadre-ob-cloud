{
  "custom": {},
  "params": {
    "deviceId": "",
    "level": 0
  },
  "propConfig": {
    "params.deviceId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.level": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 220,
      "width": 180
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Tank"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "props.params.value": {
            "binding": {
              "config": {
                "expression": "{view.params.level}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "params": {
            "max": 100,
            "showPercent": false,
            "unit": "%",
            "value": 0
          },
          "path": "Automation/Tank",
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {},
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "'cadre/palette/' + coalesce({session.custom.palette}, 'day')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
