                  "config": {
                    "script": "\tp = self.view.custom.pending\n\tmsg = cadre.hmi.command(self.session, p.path, self.view.params.deviceId, p.member, p.value)\n\tself.view.custom.pending = {'active': False, 'device': '', 'path': '', 'member': '', 'value': 0, 'text': ''}\n\tself.view.custom.message = msg"
                  },
                  "scope": "G",
