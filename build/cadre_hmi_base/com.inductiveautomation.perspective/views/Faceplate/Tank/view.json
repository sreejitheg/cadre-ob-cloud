              "shrink": 0
            },
            "props": {
              "alignItems": "center",
              "direction": "row",
              "style": {
                "gap": "8px",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Chart"
            },
            "position": {
              "basis": "0px",
              "grow": 1
            },
            "propConfig": {
              "props.plots[0].trends[1].visible": {
                "binding": {
                  "config": {
                    "expression": "{view.params.deviceId}"
                  },
                  "transforms": [
                    {
                      "code": "\treturn len(cadre.hmi.limit_rows(value)) > 0",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.series[0].data": {
                "binding": {
                  "config": {
                    "aggregate": "Average",
                    "avoidScanClassValidation": true,
                    "dateRange": {
                      "mostRecent": "{view.custom.hours}",
                      "mostRecentUnits": "HOUR"
                    },
                    "ignoreBadQuality": false,
                    "polling": {
                      "enabled": true,
                      "rate": "10"
                    },
                    "preventInterpolation": false,
                    "returnFormat": "Wide",
                    "returnSize": {
                      "numRows": "300",
                      "type": "FIXED"
                    },
                    "tags": "{view.custom.historyTags}",
                    "valueFormat": "DATASET"
                  },
                  "type": "tag-history"
                }
              },
              "props.series[1].data": {
                "binding": {
                  "config": {
                    "expression": "if(toMillis(now(10000)) > 0, {view.params.deviceId} + '|' + toStr({view.custom.hours}), '')"
                  },
                  "transforms": [
                    {
                      "code": "\tparts = (value or '').split('|')\n\treturn cadre.hmi.limit_series(parts[0], int(parts[1]) if len(parts) > 1 and parts[1] else 1)",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "plots": [
                {
                  "axes": [
                    {
                      "alignment": "left",
                      "name": "value",
                      "tick": {
                        "count": 5,
                        "label": {
                          "format": ".3~g"
                        }
                      }
                    }
                  ],
                  "markers": [],
                  "trends": [
                    {
                      "axis": "value",
                      "baselines": [],
                      "columns": [
                        {
                          "key": "value"
                        }
                      ],
                      "series": "value",
                      "type": "line",
                      "visible": true
                    },
                    {
                      "axis": "value",
                      "baselines": [],
                      "columns": [
                        {
                          "key": "hiLimit",
                          "styles": {
                            "highlighted": {
                              "fill": {
