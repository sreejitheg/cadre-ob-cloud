                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.custom.hours = 8"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "Range_8h"
                },
                "position": {
                  "basis": "72px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "if({view.custom.hours} = 8, 'cadre/button/selected cadre/font/button', 'cadre/button/flat cadre/font/button')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "cadre/button/flat cadre/font/button",
                    "height": "32px"
                  },
                  "text": "8 h"
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "Ranges"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "props": {
              "alignItems": "center",
              "direction": "row",
              "style": {
                "gap": "8px",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Chart"
            },
            "position": {
              "basis": "0px",
              "grow": 1
            },
            "propConfig": {
              "props.series[0].data": {
                "binding": {
                  "config": {
                    "aggregate": "Average",
                    "avoidScanClassValidation": true,
                    "dateRange": {
                      "mostRecent": "{view.custom.hours}",
                      "mostRecentUnits": "HOUR"
                    },
                    "ignoreBadQuality": false,
                    "polling": {
                      "enabled": true,
                      "rate": "10"
                    },
                    "preventInterpolation": false,
                    "returnFormat": "Wide",
                    "returnSize": {
                      "numRows": "300",
                      "type": "FIXED"
                    },
                    "tags": "{view.custom.historyTags}",
                    "valueFormat": "DATASET"
                  },
                  "type": "tag-history"
                }
              }
            },
            "props": {
              "plots": [
                {
                  "axes": [
                    {
                      "alignment": "left",
                      "name": "value",
                      "tick": {
                        "count": 5,
                        "label": {
                          "format": ".3~g"
                        }
                      }
                    }
                  ],
                  "markers": [],
                  "trends": [
                    {
                      "axis": "value",
                      "baselines": [],
                      "columns": [
                        {
                          "key": "step"
                        }
                      ],
                      "interpolation": "curveStepAfter",
                      "series": "value",
                      "type": "line",
                      "visible": true
                    }
                  ]
                }
              ],
              "series": [
                {
                  "data": [],
                  "name": "value"
                }
              ],
              "timeAxis": {
                "tick": {
                  "label": {
                    "format": "HH:mm"
                  }
                },
                "tickCount": 4
              },
              "timeRange": {
                "dateFormat": "D-M-YYYY",
                "timeFormat": "HH:mm",
                "visible": true
              },
              "title": {}
            },
            "type": "ia.chart.timeseries"
          }
        ],
        "meta": {
          "name": "Pane_trend"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.tab} = 'trend'"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "4px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "AlarmList"
            },
            "position": {
              "basis": "0px",
              "grow": 1
            },
            "propConfig": {
              "props.params.deviceId": {
                "binding": {
                  "config": {
                    "expression": "{view.params.deviceId}"
                  },
                  "type": "expr"
                }
              },
              "props.params.source": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.source}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "params": {
                "deviceId": "",
                "source": ""
              },
              "path": "Faceplate/Alarms",
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "Pane_alarms"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.tab} = 'alarms'"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "4px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {},
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "'cadre/palette/' + coalesce({session.custom.palette}, 'day')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "4px",
        "overflow": "hidden",
        "padding": "4px 16px 16px 16px"
      }
    },
    "type": "ia.container.flex"
  }
}
