{
  "custom": {
    "alarmCount": 0,
    "can": {
      "W1": false,
      "W10": false,
      "W11": false,
      "W12": false,
      "W13": false,
      "W14": false,
      "W15": false,
      "W16": false,
      "W17": false,
      "W18": false,
      "W19": false,
      "W2": false,
      "W3": false,
      "W4": false,
      "W5": false,
      "W6": false,
      "W7": false,
      "W8": false,
      "W9": false
    },
    "dev": {
      "allowed": {
        "W1": true,
        "W16": true,
        "W17": true,
        "W18": true,
        "W19": true,
        "W3": true,
        "W5": true
      },
      "bad": [],
      "config": 0,
      "force": "",
      "has": {
        "fault": false,
        "step": false,
        "stepText": false,
        "trigger": false
      },
      "maintain": {
        "name": "",
        "offered": false,
        "value": 0
      },
      "mnt": false,
      "owned": false,
      "owner": {
        "name": "",
        "owner": "",
        "text": ""
      },
      "pulses": {
        "trigger": "trigger"
      },
      "quality": "",
      "reason": "",
      "release": {
        "name": "",
        "offered": false,
        "value": 0
      },
      "take": {
        "name": "",
        "offered": false,
        "value": 0
      },
      "value": {
        "fault": false,
        "step": 0,
        "stepText": "",
        "trigger": false
      },
      "writable": {
        "fault": false,
        "force": false,
        "step": false,
        "stepText": false,
        "trigger": false
      },
      "write": {
        "fault": false,
        "force": false,
        "step": false,
        "stepText": false,
        "trigger": false
      }
    },
    "historyTags": [
      {
        "alias": "step",
        "path": ""
      }
    ],
    "hours": 1,
    "message": "",
    "pending": {
      "active": false,
      "device": "",
      "member": "",
      "path": "",
      "text": "",
      "value": 0
    },
    "source": "",
    "tab": "status",
    "trend": {
      "step": false
    }
  },
  "params": {
    "deviceId": "",
    "tab": ""
  },
  "propConfig": {
    "custom.alarmCount": {
      "binding": {
        "config": {
          "expression": "if(toMillis(now(2000)) > 0, {view.params.deviceId}, '')"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.alarm_count(self.session.custom.alarmScope, cadre.hmi.device_sources(self.session, value))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.can": {
      "binding": {
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.permissions(self.session)",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.dev": {
      "binding": {
        "config": {
          "expression": "if(toMillis(now(1000)) > 0, {view.params.deviceId}, '')"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.device_read(self.session, value, ['step', 'stepText', 'trigger', 'fault'])",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.historyTags": {
      "binding": {
        "config": {
          "expression": "{view.params.deviceId}"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.trend_tags(self.session, value, 'step')",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.source": {
      "binding": {
        "config": {
          "expression": "{view.params.deviceId}"
        },
        "transforms": [
          {
            "code": "\treturn ','.join(cadre.hmi.device_sources(self.session, value))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.trend": {
      "binding": {
        "config": {
          "expression": "{view.params.deviceId}"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.trended(self.session, value, ['step'])",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "params.deviceId": {
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.tab = 'status'\n\twant = self.params.tab\n\tif want in ('status', 'trend', 'alarms'):\n\t\tself.custom.tab = want\n\tself.custom.message = ''\n\tself.custom.pending = {'active': False, 'device': '', 'path': '', 'member': '', 'value': 0, 'text': ''}"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.tab": {
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.tab = 'status'\n\twant = currentValue.value\n\tif want in ('status', 'trend', 'alarms'):\n\t\tself.custom.tab = want"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 720,
      "width": 400
    }
  },
  "root": {
