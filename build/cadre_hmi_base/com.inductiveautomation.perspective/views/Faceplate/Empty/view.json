{
  "custom": {},
  "params": {
    "deviceId": "",
    "tab": ""
  },
  "propConfig": {
    "params.deviceId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tab": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 200,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Hint"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "cadre/font/body cadre/text/inactive",
            "whiteSpace": "nowrap"
          },
          "text": "Select a device"
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {},
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "'cadre/palette/' + coalesce({session.custom.palette}, 'day')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "direction": "column",
      "justify": "center",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
