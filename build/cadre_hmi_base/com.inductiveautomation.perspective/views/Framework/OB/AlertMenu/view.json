{
  "custom": {
    "ackMessage": "",
    "ackPending": {
      "active": false,
      "ids": [],
      "text": ""
    },
    "alarms": {
      "alerts": [],
      "items": []
    },
    "can": {
      "W1": false,
      "W10": false,
      "W11": false,
      "W12": false,
      "W13": false,
      "W14": false,
      "W15": false,
      "W16": false,
      "W17": false,
      "W18": false,
      "W19": false,
      "W2": false,
      "W3": false,
      "W4": false,
      "W5": false,
      "W6": false,
      "W7": false,
      "W8": false,
      "W9": false
    },
    "shown": [],
    "unacked": 0
  },
  "params": {},
  "propConfig": {
    "custom.alarms": {
      "binding": {
        "config": {
          "expression": "if(toMillis(now(2000)) > 0, '', '')"
        },
        "transforms": [
          {
            "code": "\talerts = cadre.hmi.alarm_list(self.session.custom.alarmScope, value, session=self.session)\n\tmay = cadre.hmi.allowed(self.session, 'W8')\n\treturn {'alerts': alerts, 'items': cadre.hmi.ob_items('alerts', alerts, may)}",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.can": {
      "binding": {
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.permissions(self.session)",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.shown": {
      "binding": {
        "config": {
          "expression": "{view.custom.alarms.alerts}"
        },
        "type": "expr"
      }
    },
    "custom.unacked": {
      "binding": {
        "config": {
          "expression": "{view.custom.alarms.alerts}"
        },
        "transforms": [
          {
            "code": "\treturn len(cadre.hmi.unacked_ids(value))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 600,
      "width": 640
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onAckAllClick": {
              "config": {
                "script": "\t# GF-37: event.ids holds the id of each visible row that has one (ACK visible)\n\tself.view.custom.ackMessage = cadre.hmi.ack_message(cadre.hmi.ack_event(event, self.session, path='W9'))"
              },
              "scope": "G",
              "type": "script"
            },
            "onAckClick": {
              "config": {
                "script": "\t# GF-37: event.id is the id of the row whose ACK was pressed (the alarm event's id)\n\tself.view.custom.ackMessage = cadre.hmi.ack_listed([event.id], self.session, 'W8')"
              },
              "scope": "G",
              "type": "script"
            },
            "onGoToAlertListClick": {
              "config": {
                "script": "\t# GF-37: the event carries nothing\n\tsystem.perspective.closePopup('alertMenu')\n\tsystem.perspective.navigate('/alerts')"
              },
              "scope": "G",
              "type": "script"
            },
            "onItemClick": {
              "config": {
                "script": "\t# GF-37: event.id is the row's id; its record is in view.custom.alarms.alerts\n\trows = [a for a in self.view.custom.alarms.alerts if a['id'] == event.id]\n\tif rows and cadre.hmi.select_alarm_device(self.session, rows[0]):\n\t\tsystem.perspective.closePopup('alertMenu')\n\t\tif self.session.custom.faceplateMode == 'popup':\n\t\t\tif cadre.hmi.asm_frame(self.session):\n\t\t\t\tfid = cadre.hmi.float_id(self.session.custom.selectedDevice)\n\t\t\t\tsystem.perspective.closePopup(fid)\n\t\t\t\tsystem.perspective.openPopup(id=fid, view='Framework/ASM/FloatFaceplate', params=cadre.hmi.float_params(self.session, fid), title=self.session.custom.selectedTitle, position=cadre.hmi.float_position(self.session, self.session.custom.selectedDevice), showCloseIcon=True, draggable=True, resizable=True, modal=False, overlayDismiss=False, viewportBound=True)\n\t\t\telse:\n\t\t\t\tsystem.perspective.openPopup(id='faceplatePopup', view='Framework/FaceplatePopup', title=self.session.custom.selectedTitle, position={'top': 56, 'right': 16}, showCloseIcon=True, draggable=True, resizable=True, modal=False, overlayDismiss=False, viewportBound=True)\n\t\telse:\n\t\t\tsystem.perspective.openDock(id='faceplate')\n\t\t\tself.session.custom.faceplateDocked = True"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Menu"
        },
        "position": {
          "basis": "560px",
          "shrink": 0
        },
        "propConfig": {
          "props.canAckAll": {
            "binding": {
              "config": {
                "expression": "{view.custom.can.W9}"
              },
              "type": "expr"
            }
          },
          "props.items": {
            "binding": {
              "config": {
                "expression": "{view.custom.alarms.items}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "items": []
        },
        "type": "cadre.ob.alertmenu"
      },
      {
        "children": [
          {
            "meta": {
              "name": "AckMessage"
            },
            "position": {
              "basis": "0px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.ackMessage}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "cadre/font/label cadre/text/neutral",
                "whiteSpace": "normal"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tids = cadre.hmi.unacked_ids(self.view.custom.shown)\n\tif len(ids) > 0:\n\t\tself.view.custom.ackPending = {'active': True, 'ids': ids, 'text': 'Acknowledge ' + str(len(ids)) + (' alarm?' if len(ids) == 1 else ' alarms?')}"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "AckAll"
            },
            "position": {
              "basis": "96px",
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.can.W9} && {view.custom.unacked} > 0"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "cadre/button/normal cadre/font/button",
                "height": "32px"
              },
              "text": "Ack all"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "AckBar"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "style": {
            "gap": "8px",
            "overflow": "hidden",
            "padding": "0 4px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "AckConfirmText"
            },
            "position": {
              "basis": "0px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.ackPending.text}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "cadre/font/body-active cadre/text/active",
                "whiteSpace": "normal"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.ackMessage = cadre.hmi.ack_listed(self.view.custom.ackPending.ids, self.session, 'W9')\n\tself.view.custom.ackPending = {'active': False, 'ids': [], 'text': ''}"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "AckConfirmYes"
            },
            "position": {
              "basis": "96px",
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.can.W9}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "cadre/button/normal cadre/font/button",
                "height": "36px"
              },
              "text": "Confirm"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.ackPending = {'active': False, 'ids': [], 'text': ''}"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "AckConfirmNo"
            },
            "position": {
              "basis": "96px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "cadre/button/flat cadre/font/button",
                "height": "36px"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "AckConfirm"
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.ackPending.active}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "style": {
            "borderRadius": "4px",
            "classes": "cadre/alert/badge-caution",
            "gap": "8px",
            "overflow": "hidden",
            "padding": "0 8px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {},
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "'cadre/palette/' + coalesce({session.custom.palette}, 'day')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
