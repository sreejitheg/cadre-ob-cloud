{
  "custom": {},
  "params": {
    "deviceId": "",
    "kind": "",
    "label": "",
    "popupId": "",
    "style": "openbridge",
    "tab": "",
    "title": ""
  },
  "propConfig": {
    "params.deviceId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.kind": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.style": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tab": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 600,
      "width": 450
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Description"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.label}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "cadre/font/label cadre/text/neutral",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tp = self.view.params\n\tself.session.custom.faceplateMode = 'dock'\n\tcadre.hmi.select_device(self.session, p.deviceId, p.kind, p.title, p.label, p.tab)\n\tif self.session.custom.faceplateMode == 'popup':\n\t\tif cadre.hmi.asm_frame(self.session):\n\t\t\tfid = cadre.hmi.float_id(self.session.custom.selectedDevice)\n\t\t\tsystem.perspective.closePopup(fid)\n\t\t\tsystem.perspective.openPopup(id=fid, view='Framework/ASM/FloatFaceplate', params=cadre.hmi.float_params(self.session, fid), title=self.session.custom.selectedTitle, position=cadre.hmi.float_position(self.session, self.session.custom.selectedDevice), showCloseIcon=True, draggable=True, resizable=True, modal=False, overlayDismiss=False, viewportBound=True)\n\t\telse:\n\t\t\tsystem.perspective.openPopup(id='faceplatePopup', view='Framework/FaceplatePopup', title=self.session.custom.selectedTitle, position={'top': 56, 'right': 16}, showCloseIcon=True, draggable=True, resizable=True, modal=False, overlayDismiss=False, viewportBound=True)\n\telse:\n\t\tsystem.perspective.openDock(id='faceplate')\n\t\tself.session.custom.faceplateDocked = True\n\tsystem.perspective.closePopup(p.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Dock"
            },
            "position": {
              "basis": "72px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "cadre/button/flat cadre/font/button",
                "height": "40px"
              },
              "text": "Dock"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Bar"
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "style": {
            "classes": "cadre/divider/bottom",
            "gap": "8px",
            "overflow": "hidden",
            "padding": "0 8px 0 16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Faceplate"
            },
            "position": {
              "basis": "720px",
              "shrink": 0
            },
            "propConfig": {
              "props.params.deviceId": {
                "binding": {
                  "config": {
                    "expression": "{view.params.deviceId}"
                  },
                  "type": "expr"
                }
              },
              "props.params.tab": {
                "binding": {
                  "config": {
                    "expression": "{view.params.tab}"
                  },
                  "type": "expr"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "if(coalesce({view.params.style}, '') = 'asm', case(coalesce({view.params.kind}, ''), 'pump', 'Faceplate/ASM/Pump', 'motor', 'Faceplate/ASM/Pump', 'fan', 'Faceplate/ASM/Pump', 'valve', 'Faceplate/ASM/Valve', 'analogvalve', 'Faceplate/ASM/Valve', 'damper', 'Faceplate/ASM/Valve', 'instrument', 'Faceplate/ASM/Instrument', 'readout', 'Faceplate/ASM/Instrument', 'instrument-field', 'Faceplate/ASM/Instrument', 'sequence', 'Faceplate/ASM/Sequence', 'generator', 'Faceplate/ASM/Generator', case(coalesce({view.params.kind}, ''), 'pump', 'Faceplate/Pump', 'motor', 'Faceplate/Pump', 'fan', 'Faceplate/Pump', 'valve', 'Faceplate/Valve', 'analogvalve', 'Faceplate/Valve', 'damper', 'Faceplate/Valve', 'tank', 'Faceplate/Tank', 'instrument', 'Faceplate/Instrument', 'readout', 'Faceplate/Instrument', 'instrument-field', 'Faceplate/Instrument', 'controller', 'Faceplate/Controller', 'indicator', 'Faceplate/Input', 'sequence', 'Faceplate/Sequence', 'generator', 'Faceplate/ASM/Generator', 'Faceplate/Empty')), case(coalesce({view.params.kind}, ''), 'pump', 'Faceplate/Pump', 'motor', 'Faceplate/Pump', 'fan', 'Faceplate/Pump', 'valve', 'Faceplate/Valve', 'analogvalve', 'Faceplate/Valve', 'damper', 'Faceplate/Valve', 'tank', 'Faceplate/Tank', 'instrument', 'Faceplate/Instrument', 'readout', 'Faceplate/Instrument', 'instrument-field', 'Faceplate/Instrument', 'controller', 'Faceplate/Controller', 'indicator', 'Faceplate/Input', 'sequence', 'Faceplate/Sequence', 'generator', 'Faceplate/ASM/Generator', 'Faceplate/Empty'))"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "params": {
                "deviceId": "",
                "tab": ""
              },
              "path": "Faceplate/Empty",
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "Scroll"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "overflow": "auto"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {},
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "'cadre/surface/menu cadre/palette/' + coalesce({session.custom.palette}, 'day')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
