            "onKeyDown": {
              "config": {
                "script": "\tk = ''\n\ttry:\n\t\tk = event.key\n\texcept Exception:\n\t\tk = ''\n\tif k == 'Escape':\n\t\tself.session.custom.searchQuery = ''\n\t\tself.session.custom.searchOpen = False\n\telif k == 'Enter':\n\t\tr = cadre.hmi.search_first(self.session, self.session.custom.searchQuery)\n\t\tif r is not None:\n\t\t\tif r['action'] == 'alarms' or r['action'] == 'trend':\n\t\t\t\tself.session.custom.contentNode = r['nodeId']\n\t\t\t\tsystem.perspective.navigate('/node/' + r['action'])\n\t\t\telif r['route']:\n\t\t\t\tsystem.perspective.navigate(r['route'])\n\t\t\tif r['deviceId']:\n\t\t\t\tcadre.hmi.select_device(self.session, r['deviceId'], r['deviceKind'], r['deviceTitle'], r['deviceLabel'], r['tab'], local=r['deviceLocal'])\n\t\t\t\tif self.session.custom.faceplateMode == 'popup':\n\t\t\t\t\tif cadre.hmi.asm_frame(self.session):\n\t\t\t\t\t\tfid = cadre.hmi.float_id(self.session.custom.selectedDevice)\n\t\t\t\t\t\tsystem.perspective.closePopup(fid)\n\t\t\t\t\t\tsystem.perspective.openPopup(id=fid, view='Framework/ASM/FloatFaceplate', params=cadre.hmi.float_params(self.session, fid), title=self.session.custom.selectedTitle, position=cadre.hmi.float_position(self.session, self.session.custom.selectedDevice), showCloseIcon=True, draggable=True, resizable=True, modal=False, overlayDismiss=False, viewportBound=True)\n\t\t\t\t\telse:\n\t\t\t\t\t\tsystem.perspective.openPopup(id='faceplatePopup', view='Framework/FaceplatePopup', title=self.session.custom.selectedTitle, position={'top': 56, 'right': 16}, showCloseIcon=True, draggable=True, resizable=True, modal=False, overlayDismiss=False, viewportBound=True)\n\t\t\t\telse:\n\t\t\t\t\tsystem.perspective.openDock(id='faceplate')\n\t\t\t\t\tself.session.custom.faceplateDocked = True\n\t\t\tif r['close'] == 'nav':\n\t\t\t\tsystem.perspective.closeDock('nav')\n\t\t\telif r['close'] == 'search':\n\t\t\t\tself.session.custom.searchQuery = ''\n\t\t\t\tself.session.custom.searchOpen = False\n\t\t\telif r['close']:\n\t\t\t\tsystem.perspective.closePopup(r['close'])\n\telse:\n\t\tself.session.custom.searchOpen = True"
