            "padding": "0 6px",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "gap": "4px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
