        "props": {
          "style": {
            "borderRadius": "8px",
            "classes": "cadre/font/label cadre/alert/badge-warning",
            "padding": "0 6px",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Badge_Low"
