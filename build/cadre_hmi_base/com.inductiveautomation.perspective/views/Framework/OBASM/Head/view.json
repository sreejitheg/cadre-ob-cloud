                  "config": {
                    "expression": "{view.custom.head.tabs}"
                  },
                  "transforms": [
                    {
                      "code": "\treturn cadre.hmi.obasm_items('tab', value)",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.tabs": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.head.tabs}"
                  },
                  "transforms": [
                    {
                      "code": "\treturn cadre.hmi.obasm_items('tabs', value)",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
