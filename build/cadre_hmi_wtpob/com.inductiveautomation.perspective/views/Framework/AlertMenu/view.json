  "params": {},
  "propConfig": {
    "custom.alarms": {
      "binding": {
        "config": {
          "expression": "if(toMillis(now(2000)) > 0, '', '')"
        },
        "transforms": [
          {
            "code": "\talerts = cadre.hmi.alarm_list(self.session.custom.alarmScope, value, no_ack=not cadre.hmi.allowed(self.session, 'W8'), session=self.session)\n\treturn {'alerts': alerts, 'rectified': len([a for a in alerts if a['active'] is not True])}",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.can": {
      "binding": {
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "code": "\treturn cadre.hmi.permissions(self.session)",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.shown": {
      "binding": {
        "config": {
          "expression": "{view.custom.alarms.alerts}"
        },
        "type": "expr"
      }
    },
    "custom.unacked": {
      "binding": {
        "config": {
          "expression": "{view.custom.alarms.alerts}"
        },
        "transforms": [
          {
            "code": "\treturn len(cadre.hmi.unacked_ids(value))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    }
  },
