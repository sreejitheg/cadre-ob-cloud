    "alarms": {
      "alerts": [],
      "rectified": 0
    },
    "can": {
      "W1": false,
      "W10": false,
      "W11": false,
      "W12": false,
      "W13": false,
      "W14": false,
      "W15": false,
      "W16": false,
      "W17": false,
