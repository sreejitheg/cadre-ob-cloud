     "tagType": "AtomicTag",
     "valueSource": "memory",
     "dataType": "Boolean",
     "value": false,
     "eventScripts": [
      {
       "eventid": "valueChanged",
       "script": "\tif currentValue.value and not initialChange:\n\t\tsystem.tag.writeBlocking(['[default]cadre_hmi_pilot/SQ1/started', '[default]cadre_hmi_pilot/SQ1/trigger'],\n\t\t\t[system.date.toMillis(system.date.now()), False])\n"
      }
     ]
    },
    {
     "name": "started",
     "tagType": "AtomicTag",
     "valueSource": "memory",
     "dataType": "Int8",
     "value": 0
    },
    {
     "name": "step",
     "tagType": "AtomicTag",
     "valueSource": "expr",
     "dataType": "Int4",
     "expression": "if(coalesce({[default]cadre_hmi_pilot/src/SQ1_FLT}, false), 4, if(coalesce({[.]started}, 0) = 0, 1, if((toMillis(now(1000)) - coalesce({[.]started}, 0)) < 5000, 2, if((toMillis(now(1000)) - coalesce({[.]started}, 0)) < 10000, 3, 1))))",
     "executionMode": "FixedRate",
     "historyEnabled": true,
     "historyProvider": "Sample_SQLite_Database"
    },
    {
     "name": "stepText",
     "tagType": "AtomicTag",
     "valueSource": "expr",
     "dataType": "String",
     "expression": "case(coalesce({[.]step}, 0), 1, 'Standby', 2, 'Drive Out', 3, 'Drive Back', 4, 'Fault', '')",
     "executionMode": "FixedRate"
    },
    {
     "name": "fault",
     "tagType": "AtomicTag",
     "valueSource": "reference",
     "dataType": "Boolean",
     "sourceTagPath": "[default]cadre_hmi_pilot/src/SQ1_FLT"
