   "tagType": "Folder",
   "tags": [
    {
     "name": "value",
     "tagType": "AtomicTag",
     "valueSource": "expr",
     "dataType": "Float8",
     "expression": "coalesce({[.]value}, 50) + (coalesce({[.]out}, 50) - coalesce({[.]value}, 50)) * 0.1",
     "executionMode": "FixedRate",
     "historyEnabled": true,
     "historyProvider": "Sample_SQLite_Database"
    },
    {
     "name": "sp",
     "tagType": "AtomicTag",
     "valueSource": "memory",
     "dataType": "Float8",
     "value": 50.0,
     "historyEnabled": true,
     "historyProvider": "Sample_SQLite_Database"
    },
    {
     "name": "out",
     "tagType": "AtomicTag",
     "valueSource": "expr",
     "dataType": "Float8",
     "expression": "if(coalesce({[.]manual}, false), coalesce({[.]manOut}, 0), if((coalesce({[.]sp}, 50) + coalesce({[.]gain}, 1) * (coalesce({[.]sp}, 50) - coalesce({[.]value}, 50))) > 100, 100, if((coalesce({[.]sp}, 50) + coalesce({[.]gain}, 1) * (coalesce({[.]sp}, 50) - coalesce({[.]value}, 50))) < 0, 0, (coalesce({[.]sp}, 50) + coalesce({[.]gain}, 1) * (coalesce({[.]sp}, 50) - coalesce({[.]value}, 50))))))",
     "executionMode": "FixedRate",
     "historyEnabled": true,
     "historyProvider": "Sample_SQLite_Database"
    },
    {
     "name": "manual",
     "tagType": "AtomicTag",
     "valueSource": "memory",
     "dataType": "Boolean",
     "value": false
    },
    {
