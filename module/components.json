     "up",
     "down",
     "left",
     "right",
     "none"
    ],
    "default": "right"
   },
   "variant": {
    "type": "string",
    "enum": [
     "regular",
     "double",
     "forward",
     "flat",
     "flat-forward"
    ],
    "default": "regular"
   },
   "direction": {
    "type": "string",
    "enum": [
     "forward",
     "forward-fast",
     "forward-stopped",
     "backward",
     "backward-fast",
     "backward-stopped",
     "standby"
    ],
    "default": "forward"
   },
   "readoutPosition": {
    "type": "string",
    "enum": [
     "top",
     "bottom",
     "left",
     "right"
    ],
    "default": "bottom"
   },
   "readoutSize": {
    "type": "string",
    "enum": [
     "small",
     "regular",
     "enhanced"
    ],
    "default": "regular"
   },
   "tag": {
    "type": "string",
    "default": ""
   },
   "positioning": {
    "type": "string",
    "enum": [
     "point",
     "symbol",
     "button"
    ],
    "default": "point"
   },
   "activated": {
    "type": "boolean",
    "default": false
   },
   "alert": {
    "type": "boolean",
    "default": false
   },
   "alertFrameType": {
    "type": "string",
    "enum": [
     "regular",
     "small-side-flip",
     "large-side-flip",
     "bottom-flip",
     "top-flip"
    ],
    "default": "small-side-flip"
   },
   "alertFrameThickness": {
    "type": "string",
    "enum": [
     "small",
     "large"
    ],
    "default": "small"
   },
   "alertFrameStatus": {
    "type": "string",
    "enum": [
     "alarm",
     "warning",
     "caution",
     "level-critical",
     "level-high",
     "level-medium",
     "level-low",
     "level-diagnostic"
    ],
    "default": "alarm"
   },
   "alertFrameMode": {
    "type": "string",
    "enum": [
     "acked-active",
     "unacked-active",
     "unacked-rectified"
    ],
    "default": "acked-active"
   },
   "showAlertIcon": {
    "type": "boolean",
    "default": false
   },
   "progress": {
    "type": "boolean",
    "default": false
   },
   "progressMode": {
    "type": "string",
    "enum": [
     "determinate",
     "indeterminate",
     "progressive-indeterminate"
    ],
    "default": "indeterminate"
   },
