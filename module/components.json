{
 "cadre.ob.pump": {
  "element": "obc-pump",
  "title": "OB Pump",
  "palette": "OpenBridge pump: state, speed readout, badges and alert frame",
  "schema": "schemas/pump.props.json",
  "defaultSize": {
   "width": 96,
   "height": 96
  },
  "props": {
   "vertical": {
    "type": "boolean",
    "default": false
   },
   "on": {
    "type": "boolean",
    "default": false
   },
   "speedInPercent": {
    "type": "number",
    "default": 0
   },
   "speed": {
    "type": [
     "number",
     "null"
    ],
    "default": null
   },
   "speedUnit": {
    "type": "string",
    "default": "%"
   },
   "speedMaxDigits": {
    "type": "number",
    "default": 3
   },
   "labelDirection": {
    "type": "string",
