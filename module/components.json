    "type": "string",
    "default": ""
   },
   "badgeDuty": {
    "type": "boolean",
    "default": false
   },
   "outOfService": {
    "type": "boolean",
    "default": false
   },
   "componentSize": {
    "type": "string",
    "enum": [
     "regular",
     "medium",
     "large",
     "xl"
    ],
    "default": "regular"
   }
  }
 },
