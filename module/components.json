     "level-medium",
     "level-low",
     "level-diagnostic"
    ],
    "default": "alarm"
   },
   "showAlertIcon": {
    "type": "boolean",
    "default": false
   },
   "percentFractionDigits": {
    "type": "number",
    "default": 0
   },
   "badgeControl": {
    "type": "string",
    "enum": [
     "none",
     "local",
     "local-only",
     "manual",
     "manual-only",
     "auto"
    ],
    "default": "none"
   },
   "badgeAlert": {
    "type": "string",
    "enum": [
     "none",
     "silence",
     "caution",
     "warning",
     "alarm",
     "level-critical",
     "level-high",
     "level-medium",
     "level-low",
     "level-diagnostic"
    ],
    "default": "none"
   },
   "badgeInterlock": {
    "type": "string",
    "enum": [
     "none",
     "interlock",
     "interlock-inhibit"
    ],
