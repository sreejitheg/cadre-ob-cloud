     "none",
     "command-locked"
    ],
    "default": "none"
   },
   "badgeInterlock": {
    "type": "string",
    "enum": [
     "none",
     "interlock",
     "interlock-inhibit"
    ],
    "default": "none"
   },
   "badgeAlert": {
    "type": "string",
    "enum": [
     "none",
     "silence",
     "caution",
     "warning",
     "alarm",
