{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ariaLabel": {
      "type": "string",
      "default": "Check valve",
      "description": "Accessible name for the symbol."
    },
    "vertical": {
      "type": "boolean",
      "default": false,
      "description": "Rotates the symbol 90\u00b0 counter-clockwise to match a vertical flow path."
    },
    "componentSize": {
      "type": "string",
      "enum": [
        "regular",
        "medium",
        "large",
        "xl"
      ],
      "default": "regular",
      "description": "OpenBridge component size: regular, medium, large or xl."
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}
