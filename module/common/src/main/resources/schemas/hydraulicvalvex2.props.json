{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "2/2",
        "3/2",
        "4/2"
      ],
      "default": "2/2",
      "description": "Port/position configuration."
    },
    "ariaLabel": {
      "type": "string",
      "default": "Hydraulic valve",
      "description": "Accessible name for the control."
    },
    "selectedPosition": {
      "type": "number",
      "default": 1,
      "description": "Zero-based index of the currently selected position. Out-of-range values are clamped."
    },
    "vertical": {
      "type": "boolean",
      "default": false,
      "description": "Lays the control out vertically: positions stack top to bottom and the position symbols rotate 90\u00b0 counter-clockwise to match a vertical flow path."
    },
    "componentSize": {
      "type": "string",
      "enum": [
        "regular",
        "medium",
        "large",
        "xl"
      ],
      "default": "regular",
      "description": "Component size: regular, medium, large or xl."
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}
