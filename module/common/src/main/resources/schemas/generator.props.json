{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "regular",
        "double",
        "forward",
        "square",
        "flat",
        "flat-forward"
      ],
      "default": "regular",
      "description": "OpenBridge `obc-automation-button` property `variant`."
    },
    "state": {
      "type": "string",
      "enum": [
        "closed",
        "open"
      ],
      "default": "open",
      "description": "OpenBridge `obc-automation-button` property `state`."
    },
    "static": {
      "type": "boolean",
      "default": false,
      "description": "OpenBridge `obc-automation-button` property `static`."
    },
    "activated": {
      "type": "boolean",
      "default": false,
      "description": "Enables the activated background color, used to indicate that the button is activated/selected."
    },
    "tag": {
      "type": "string",
      "default": "",
      "description": "Available when showReadoutStack==true."
    },
    "readoutPosition": {
      "type": "string",
      "enum": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "default": "bottom",
      "description": "Available when showReadoutStack==true."
    },
    "readoutSize": {
      "type": "string",
      "enum": [
        "small",
        "regular",
        "enhanced"
      ],
      "default": "regular",
      "description": "Available when showReadoutStack==true."
    },
    "alert": {
      "type": "boolean",
      "default": false,
      "description": "OpenBridge `obc-automation-button` property `alert`."
    },
    "alertFrameType": {
      "type": "string",
      "enum": [
        "regular",
        "small-side-flip",
        "large-side-flip",
        "bottom-flip",
        "top-flip"
      ],
      "default": "small-side-flip",
      "description": "Available when alert==true."
    },
    "alertFrameThickness": {
      "type": "string",
      "enum": [
        "small",
        "large"
      ],
      "default": "small",
      "description": "Available when alert==true."
    },
    "alertFrameStatus": {
      "type": "string",
      "enum": [
        "alarm",
        "warning",
        "caution",
        "level-critical",
        "level-high",
        "level-medium",
        "level-low",
        "level-diagnostic"
      ],
      "default": "alarm",
      "description": "Available when alert==true."
    },
    "alertFrameMode": {
      "type": "string",
      "enum": [
        "acked-active",
        "unacked-active",
        "unacked-rectified"
      ],
      "default": "acked-active",
      "description": "Available when alert==true."
    },
    "showAlertIcon": {
      "type": "boolean",
      "default": false,
      "description": "Available when alert==true."
    },
    "progress": {
      "type": "boolean",
      "default": false,
      "description": "OpenBridge `obc-automation-button` property `progress`."
    },
    "progressMode": {
      "type": "string",
      "enum": [
        "determinate",
        "indeterminate",
        "progressive-indeterminate"
      ],
      "default": "indeterminate",
      "description": "Available when progress==true."
    },
    "progressValue": {
      "type": "number",
      "default": 0,
      "description": "Available when progress==true && progressMode in [determinate, progressive-indeterminate]."
    },
    "direction": {
      "type": "string",
      "enum": [
        "forward",
        "forward-fast",
        "forward-stopped",
        "backward",
        "backward-fast",
        "backward-stopped",
        "standby"
      ],
      "default": "forward",
      "description": "Available when variant in [double, forward, flatForward]."
    },
    "positioning": {
      "type": "string",
      "enum": [
        "point",
        "symbol",
        "button"
      ],
      "default": "point",
      "description": "OpenBridge `obc-automation-button` property `positioning`."
    },
    "orientation": {
      "type": "string",
      "enum": [
        "horizontal",
        "verticalRight",
        "verticalLeft"
      ],
      "default": "horizontal",
      "description": "OpenBridge `obc-automation-button` property `orientation`."
    },
    "hasBadgeSpacer": {
      "type": "boolean",
      "default": false,
      "description": "Badge spacer should be set to true if there is a badge on the same side as the label"
    },
    "on": {
      "type": "boolean",
      "default": false,
      "description": "Whether the generator is running. Chooses the running or the stopped generator icon in the symbol (and the On or Off state row of its status word); the OpenBridge automation button has no such property."
    },
    "showStatus": {
      "type": "boolean",
      "default": true,
      "description": "Whether the symbol draws its status readouts. False hides every status word, including the element's own Off, and the speed readout (the element's showStatus); the tag stays."
    },
    "statusText": {
      "type": "string",
      "default": "",
      "description": "When not empty, the status word drawn in the element's status place (for example On or Off) in place of its own readout; empty keeps the element's own."
    },
    "badgeDuty": {
      "type": "boolean",
      "default": false,
      "description": "The OpenBridge duty badge on the symbol, in the first free corner (bottom left, bottom right, top left, top right); not drawn while the interlock badge, which is the same icon, is."
    },
    "outOfService": {
      "type": "boolean",
      "default": false,
      "description": "The symbol greyed and marked with the word OOS, as the stock library view draws an out of service symbol."
    },
    "componentSize": {
      "type": "string",
      "enum": [
        "regular",
        "medium",
        "large",
        "xl"
      ],
      "default": "regular",
      "description": "OpenBridge component size: regular, medium, large or xl."
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}
