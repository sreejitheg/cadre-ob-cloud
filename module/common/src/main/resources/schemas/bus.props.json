{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "type": "string",
      "default": "",
      "description": "Centered label text; the bar renders empty when omitted."
    },
    "size": {
      "type": "string",
      "enum": [
        "small",
        "medium"
      ],
      "default": "small",
      "description": "Bar height and typography preset."
    },
    "variant": {
      "type": "string",
      "enum": [
        "regular",
        "enhanced",
        "medium"
      ],
      "default": "regular",
      "description": "Color family of the bar."
    },
    "tint": {
      "type": "boolean",
      "default": false,
      "description": "Use the light (tinted) color pairing of the selected variant."
    },
    "vertical": {
      "type": "boolean",
      "default": false,
      "description": "Render the bar vertically with the label rotated 90\u00b0 clockwise."
    },
    "componentSize": {
      "type": "string",
      "enum": [
        "regular",
        "medium",
        "large",
        "xl"
      ],
      "default": "regular",
      "description": "Component size: regular, medium, large or xl."
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}
