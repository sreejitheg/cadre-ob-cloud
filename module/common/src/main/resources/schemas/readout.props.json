{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "orientation": {
      "type": "string",
      "enum": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "default": "bottom",
      "description": "Property `orientation` of the `obc-transmitter` element."
    },
    "type": {
      "type": "string",
      "enum": [
        "indicator",
        "value",
        "horizontal-graph",
        "vertical-graph"
      ],
      "default": "value",
      "description": "Property `type` of the `obc-transmitter` element."
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "default": null,
      "description": "Property `value` of the `obc-transmitter` element."
    },
    "unit": {
      "type": "string",
      "default": "",
      "description": "Property `unit` of the `obc-transmitter` element."
    },
    "fractionDigits": {
      "type": "number",
      "default": 1,
      "description": "Property `fractionDigits` of the `obc-transmitter` element."
    },
    "maxDigits": {
      "type": "number",
      "default": 0,
      "description": "Integer digits to reserve / hint (independent of fractionDigits)."
    },
    "hintedZeros": {
      "type": "boolean",
      "default": false,
      "description": "Property `hintedZeros` of the `obc-transmitter` element."
    },
    "hasSignSpacer": {
      "type": "boolean",
      "default": false,
      "description": "Reserve a minus-sign column on every segment, filled by the real sign only while a value is negative, so the chip's width does not change across zero."
    },
    "size": {
      "type": "string",
      "enum": [
        "regular",
        "medium",
        "large"
      ],
      "default": "regular",
      "description": "Property `size` of the `obc-transmitter` element."
    },
    "hasIcon": {
      "type": "boolean",
      "default": false,
      "description": "Property `hasIcon` of the `obc-transmitter` element."
    },
    "hasAdvice": {
      "type": "boolean",
      "default": false,
      "description": "Property `hasAdvice` of the `obc-transmitter` element."
    },
    "hasAlert": {
      "type": "boolean",
      "default": false,
      "description": "Wrap the transmitter in an <obc-alert-frame> (alarm) when true."
    },
    "adviceValue": {
      "type": [
        "number",
        "null"
      ],
      "default": null,
      "description": "Advisory value shown in the leading advice segment when hasAdvice."
    },
    "hasSetPoint": {
      "type": "boolean",
      "default": false,
      "description": "Property `hasSetPoint` of the `obc-transmitter` element."
    },
    "setpointValue": {
      "type": [
        "number",
        "null"
      ],
      "default": null,
      "description": "Target value shown in the setpoint segment when hasSetPoint."
    },
    "tag": {
      "type": "string",
      "default": "",
      "description": "Tag identifier shown when type is indicator (e.g. TT)."
    },
    "idTag": {
      "type": "string",
      "default": "",
      "description": "Optional identifier shown below the chip (e.g. #0000)."
    },
    "stretch": {
      "type": "boolean",
      "default": false,
      "description": "The readout fills its component box (chip and identifier centred in it), so readouts of equal boxes show equal widths with their values aligned, instead of sizing to the content."
    },
    "componentSize": {
      "type": "string",
      "enum": [
        "regular",
        "medium",
        "large",
        "xl"
      ],
      "default": "regular",
      "description": "Component size: regular, medium, large or xl."
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}
