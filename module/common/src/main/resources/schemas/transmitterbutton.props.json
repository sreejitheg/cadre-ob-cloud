{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "value",
        "tag"
      ],
      "default": "value",
      "description": "Property `variant` of the `obc-transmitter-button` element."
    },
    "size": {
      "type": "string",
      "enum": [
        "regular",
        "medium",
        "large"
      ],
      "default": "regular",
      "description": "Property `size` of the `obc-transmitter-button` element."
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "default": null,
      "description": "Property `value` of the `obc-transmitter-button` element."
    },
    "unit": {
      "type": "string",
      "default": "",
      "description": "Property `unit` of the `obc-transmitter-button` element."
    },
    "fractionDigits": {
      "type": "number",
      "default": 1,
      "description": "Property `fractionDigits` of the `obc-transmitter-button` element."
    },
    "maxDigits": {
      "type": "number",
      "default": 0,
      "description": "Integer digits to reserve / hint (independent of fractionDigits)."
    },
    "hintedZeros": {
      "type": "boolean",
      "default": false,
      "description": "Property `hintedZeros` of the `obc-transmitter-button` element."
    },
    "hasSignSpacer": {
      "type": "boolean",
      "default": false,
      "description": "Reserve a minus-sign column on every segment, filled by the real sign only while a value is negative, so the width does not change across zero."
    },
    "hasIcon": {
      "type": "boolean",
      "default": false,
      "description": "Property `hasIcon` of the `obc-transmitter-button` element."
    },
    "hasAdvice": {
      "type": "boolean",
      "default": false,
      "description": "Property `hasAdvice` of the `obc-transmitter-button` element."
    },
    "adviceValue": {
      "type": [
        "number",
        "null"
      ],
      "default": null,
      "description": "Advisory value shown in the leading advice segment when hasAdvice."
    },
    "hasSetPoint": {
      "type": "boolean",
      "default": false,
      "description": "Property `hasSetPoint` of the `obc-transmitter-button` element."
    },
    "setpointValue": {
      "type": [
        "number",
        "null"
      ],
      "default": null,
      "description": "Target value shown in the setpoint segment when hasSetPoint."
    },
    "label": {
      "type": "string",
      "default": "",
      "description": "Short tag identifier shown in the tag variant (e.g. TT)."
    },
    "componentSize": {
      "type": "string",
      "enum": [
        "regular",
        "medium",
        "large",
        "xl"
      ],
      "default": "regular",
      "description": "Component size: regular, medium, large or xl."
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}
