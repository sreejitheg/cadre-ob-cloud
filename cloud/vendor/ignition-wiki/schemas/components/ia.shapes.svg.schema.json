          "type": "string"
        },
        "backgroundOrigin": {
          "enum": [
            "padding-box",
            "content-box",
            "border-box"
          ],
          "required": true,
          "type": "string"
        },
        "backgroundRepeat": {
          "enum": [
            "repeat",
            "space",
            "round",
            "repeat-y",
            "repeat-x",
            "repeat no-repeat",
            "no-repeat"
          ],
          "required": true,
          "type": "string"
        },
        "backgroundSize": {
          "required": true,
          "type": "string"
        },
        "borderCollapse": {
          "enum": [
            "separate",
            "collapse"
          ],
          "required": true,
          "type": "string"
        },
        "borderImageRepeat": {
          "enum": [
