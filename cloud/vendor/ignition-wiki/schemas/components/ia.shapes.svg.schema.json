            "string",
            "number"
          ]
        },
        "fontStretch": {
          "enum": [
            "normal",
            "ultra-expanded",
            "ultra-condensed",
            "semi-expanded",
            "semi-condensed",
            "extra-expanded",
            "extra-condensed",
            "expanded",
            "condensed"
