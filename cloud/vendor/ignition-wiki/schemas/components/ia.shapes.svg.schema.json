          "enum": [
            "auto",
            "right",
            "page",
            "left",
            "column",
            "avoid-page",
            "avoid-column",
            "avoid",
            "always"
          ],
          "required": true,
          "type": "string"
        },
        "breakBefore": {
          "enum": [
            "auto",
            "right",
            "page",
            "left",
            "column",
            "avoid-page",
            "avoid-column",
            "avoid",
            "always"
          ],
          "required": true,
          "type": "string"
        },
        "breakInside": {
          "enum": [
            "auto",
            "avoid-page",
            "avoid-column",
            "avoid"
          ],
          "required": true,
          "type": "string"
        },
        "captionSide": {
