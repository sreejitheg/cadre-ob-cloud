  "$id": "https://ignition-wiki.local/components/ia.shapes.svg.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "Element": {
      "default": {
        "type": "group"
      },
      "properties": {
        "clipPath": {
          "default": {},
          "type": [
            "string",
            "object"
          ]
        },
        "clipRule": {
          "default": "nonzero",
          "enum": [
            "nonzero",
            "evenodd"
          ],
          "type": "string"
        },
        "elements": {
          "items": {
            "$ref": "#/definitions/Element"
          },
          "type": "array"
        },
        "end": {
          "$ref": "#/definitions/Marker"
        },
        "fill": {
          "default": {},
          "description": "Configuration options for the color inside a shape",
          "properties": {
            "opacity": {
              "default": 1,
              "type": [
                "string",
                "number"
              ]
            },
            "paint": {
              "format": "color",
              "type": [
                "string",
                "object"
              ]
            },
            "rule": {
              "default": "nonzero",
              "enum": [
                "nonzero",
                "evenodd"
              ],
              "type": "string"
            },
            "url": {
              "default": "",
              "type": "string"
            }
          },
          "type": [
            "string",
            "object"
          ]
        },
        "id": {
          "default": "",
          "description": "A DOM id that will be automatically prepended with prefix to prevent collisions with other DOM ids. Manually assigning new ids will break rendering of elements referencing this id.",
          "type": "string"
        },
        "mask": {
          "default": {},
          "type": [
            "string",
            "object"
          ]
        },
        "name": {
          "default": "",
          "description": "A name to be displayed within the Drawing Editor Layer's panel.",
          "type": "string"
        },
        "opacity": {
          "default": "",
          "description": "How transparent an element and its children are.",
          "type": [
            "number",
            "string"
          ]
        },
        "overflow": {
          "default": "",
          "description": "Behavior when an element's content is too big to fit in its block formatting context.  Browser support varies.",
          "enum": [
            "",
            "visible",
            "hidden",
            "scroll",
            "auto"
          ],
          "type": "string"
        },
        "pathLength": {
          "default": "",
          "description": "Advanced SVG attribute representing the total length for the path, in user units.",
          "type": [
            "number",
            "string"
          ]
        },
        "start": {
          "$ref": "#/definitions/Marker"
        },
        "stroke": {
          "default": {},
          "description": "Configuration options for the color of the outline of a shape",
          "properties": {
            "dasharray": {
              "default": "",
              "type": "string"
            },
            "dashoffset": {
              "default": "",
              "type": "string"
            },
            "linecap": {
              "default": "butt",
              "enum": [
                "butt",
                "round",
                "square"
              ],
              "type": "string"
            },
            "linejoin": {
              "default": "miter",
              "enum": [
                "miter",
                "miter-clip",
                "round",
                "bevel"
              ],
              "type": "string"
            },
            "miterlimit": {
              "default": "",
              "type": "string"
            },
            "opacity": {
              "default": 1,
              "type": [
                "string",
                "number"
              ]
            },
            "paint": {
              "format": "color",
              "type": [
                "string",
                "object"
              ]
            },
            "url": {
              "default": "",
              "type": "string"
            },
            "width": {
              "default": "",
              "type": [
                "string",
                "number"
              ]
            }
          },
          "type": [
            "string",
            "object"
          ]
        },
        "style": {
          "$ref": "#/$defs/style-properties.schema"
        },
        "textPath": {
          "default": {},
          "description": "Renders text along the shape of a path.  Applicable to text type Elements only.",
          "properties": {
            "path": {
              "default": "",
              "description": "A literal path SVG path definition or an id reference to a path #pathId.",
              "type": "string"
            },
            "spacing": {
              "default": "exact",
              "description": "How space between glyphs should be handled.",
              "enum": [
                "auto",
                "exact"
              ],
              "type": "string"
            },
            "startOffset": {
              "default": 0,
              "description": "How far the beginning of the text should be offset from the beginning of the path.",
              "type": [
                "string",
