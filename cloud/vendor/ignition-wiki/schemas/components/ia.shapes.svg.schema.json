            "table-row-group",
            "table-row",
            "table-header-group",
            "table-footer-group",
            "table-column-group",
            "table-column",
            "table-cell",
            "table-caption",
            "table",
            "run-in",
            "none",
            "list-item",
            "inline-table",
            "inline-flex",
            "inline-block",
            "flex",
            "compact",
            "block"
