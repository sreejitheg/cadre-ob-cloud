          "required": true,
          "type": "string"
        },
        "clearAfter": {
          "enum": [
            "none",
            "top",
            "start",
            "right",
            "outside",
            "left",
            "inside",
            "end",
            "descendants",
            "bottom",
            "both"
          ],
          "required": true,
          "type": "string"
        },
        "color": {
