  "$id": "https://ignition-wiki.local/components/ia.display.video-player.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Props contract for the Perspective component ia.display.video-player. Ignition 8.3, Perspective module 3.3.6, registry ia.components.json hash e4dad85e3a1108251d7c.",
  "properties": {
    "autohideControls": {
      "default": false,
      "description": "The visible state of the video controls. If set to true, controls will auto-hide when the cursor is not hovering the video.",
      "type": "boolean",
      "visibleWhen": {
        "equals": false,
        "property": "liveFeed"
      }
    },
    "controlStyle": {
      "$ref": "#/$defs/style-properties.schema",
      "default": {
        "classes": ""
      },
      "description": "The styles to apply to the individual controls.",
      "visibleWhen": {
        "equals": false,
        "property": "liveFeed"
      }
    },
    "controls": {
      "properties": {
        "autoplay": {
          "default": false,
          "description": "Should the video play by default once loaded. NOTE: The video will be muted when initially playing when this is enabled.",
          "type": "boolean"
        },
        "loop": {
          "default": false,
          "description": "Should the video play continuously.",
          "type": "boolean"
        },
        "mute": {
          "default": false,
          "description": "The muted state of the video's audio track.",
          "type": "boolean"
        },
        "play": {
          "default": false,
          "description": "The play state of the video.",
          "type": "boolean"
        },
        "playRate": {
          "default": 1,
          "description": "The speed at which the video will be played (where 1 is normal speed, .5 is half speed, 2 is double speed, etc.).",
          "type": "number"
        },
        "seek": {
          "default": 0,
          "description": "The time (in seconds) from which the video should start playing.",
          "type": "number"
        },
        "volume": {
          "default": 75,
          "description": "The percentage of maximum volume in use (from 0 to 100).",
          "type": "number"
        }
      },
      "type": "object",
      "visibleWhen": {
        "equals": false,
        "property": "liveFeed"
      }
    },
    "liveFeed": {
      "default": false,
      "description": "This should be set to true if the source of the video is a live camera feed.",
      "type": "boolean"
    },
    "poster": {
      "default": "",
      "description": "The location of the poster image to use as the background while the video is loading and before it has been played.",
      "type": "string",
      "visibleWhen": {
        "equals": false,
        "property": "liveFeed"
      }
    },
    "source": {
      "default": "",
      "description": "The location of the video source.",
      "type": "string"
    },
    "status": {
      "properties": {
        "ended": {
          "default": false,
          "description": "True when playback has stopped because the end of the media was reached.",
          "type": "boolean"
        },
        "loadedData": {
          "default": false,
          "description": "True when the current playback position of the media has finished loading; often the first frame.",
          "type": "boolean"
        },
        "paused": {
          "default": false,
          "description": "True when playback has been paused.",
          "type": "boolean"
        },
        "playing": {
          "default": false,
          "description": "True when playback is ready to start after having been paused or delayed due to lack of data.",
          "type": "boolean"
        },
        "progress": {
          "default": 0,
          "description": "Number representing the time (in seconds) where playback has occurred.",
          "type": "number"
        },
        "rateChanged": {
          "default": 1,
          "description": "Number representing the current playback rate (1 being normal speed).",
          "type": "number"
        },
        "seeked": {
          "default": 0,
          "description": "Number representing the time (in seconds) where the seek action was completed.",
          "type": "number"
        },
        "seeking": {
          "default": false,
          "description": "True when a seek operation is in progress.",
          "type": "boolean"
        },
        "waiting": {
          "default": false,
          "description": "True when playback has stopped because of a temporary lack of data.",
          "type": "boolean"
        }
      },
      "type": "object",
      "visibleWhen": {
        "equals": false,
        "property": "liveFeed"
      }
    },
    "style": {
      "$ref": "#/$defs/style-properties.schema",
      "default": {
        "classes": ""
      },
      "description": "The styles to apply to the component."
    }
  },
