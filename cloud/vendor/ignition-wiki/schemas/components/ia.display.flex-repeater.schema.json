  "definitions": {
    "elementPosition": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "auto",
            "flex-start",
            "flex-end",
            "center",
            "baseline",
            "stretch"
          ],
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/css-length.schema"
        },
        "grow": {
          "type": "number"
        },
        "shrink": {
          "type": "number"
        }
      }
    }
  },
  "description": "Props contract for the Perspective component ia.display.flex-repeater. Ignition 8.3, Perspective module 3.3.6, registry ia.components.json hash e4dad85e3a1108251d7c.",
  "properties": {
    "alignContent": {
      "default": "stretch",
      "description": "Adjusts alignment of repeated views when there is free space in the cross axis.",
      "enum": [
        "flex-start",
        "flex-end",
        "center",
        "space-between",
        "space-around",
        "stretch"
      ],
      "type": "string"
    },
    "alignItems": {
      "default": "stretch",
      "description": "Adjusts placement of repeated views along the cross axis when there is extra space.",
      "enum": [
        "flex-start",
        "flex-end",
        "center",
        "baseline",
        "stretch"
      ],
      "type": "string"
    },
    "direction": {
      "default": "row",
      "description": "Direction of layout of repeated views.",
      "enum": [
        "row",
        "row-reverse",
        "column",
        "column-reverse"
      ],
      "type": "string"
    },
    "elementPosition": {
      "$ref": "#/definitions/elementPosition",
      "default": {
        "basis": 0,
        "grow": 1,
        "shrink": 1
      },
      "description": "Flex position properties that are applied to all repeated views."
    },
    "elementStyle": {
      "$ref": "#/$defs/style-properties.schema",
      "description": "Style properties that are applied to all repeated views."
    },
    "instances": {
      "default": [],
      "description": "List of params for each rendered view. Each instance will contain an instanceStyle and instancePosition property. Changing these properties will override the styling and positioning applied by elementStyle and elementPosition.",
      "items": {
        "additionalProperties": true,
        "extension": {
          "view-params": {
            "path": "/path"
          }
        },
        "properties": {
          "instancePosition": {
            "$ref": "#/definitions/elementPosition",
            "default": {}
          },
          "instanceStyle": {
            "$ref": "#/$defs/style-properties.schema"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "justify": {
      "default": "flex-start",
      "description": "Adjusts placement of repeated views along the main axis when there is extra space, which may be used to fill areas before, after or in-between.",
      "enum": [
        "flex-start",
        "flex-end",
        "center",
        "space-between",
        "space-around",
        "space-evenly"
      ],
      "type": "string"
    },
    "loading": {
      "properties": {
        "order": {
          "default": "after-parent",
          "description": "Controls when the embedded views load: after the parent is displayed or combined with the parent view loading",
          "enum": [
            "after-parent",
            "with-parent"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "path": {
      "default": "",
      "description": "Path of the view to display",
      "format": "view-path",
      "type": "string"
    },
    "style": {
      "$ref": "#/$defs/style-properties.schema",
      "default": {
        "classes": "",
        "overflow": "auto"
      }
    },
    "useDefaultViewHeight": {
      "default": true,
      "description": "Use of view's default height instead of adjusting based on the content's height. This will override all flex position properties in the column and column-reverse direction.",
      "type": "boolean"
    },
    "useDefaultViewWidth": {
      "default": true,
      "description": "Use of view's default width instead of adjusting based on the content's width. This will override all flex position properties in the row and row-reverse direction.",
      "type": "boolean"
    },
