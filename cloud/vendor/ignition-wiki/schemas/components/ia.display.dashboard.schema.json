  "$id": "https://ignition-wiki.local/components/ia.display.dashboard.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Props contract for the Perspective component ia.display.dashboard. Ignition 8.3, Perspective module 3.3.6, registry ia.components.json hash e4dad85e3a1108251d7c.",
  "properties": {
    "availableWidgets": {
      "default": [],
      "items": {
        "properties": {
          "body": {
            "description": "Widget body configuration.",
            "properties": {
              "style": {
                "$ref": "#/$defs/style-properties.schema"
              }
            },
            "type": "object"
          },
          "category": {
            "default": "",
            "description": "A category in which to group this widget when displayed in the add widgets modal.",
            "type": [
              "string",
              "number"
            ]
          },
          "defaultSize": {
            "properties": {
              "columnSpan": {
                "default": 2,
                "type": "number"
              },
              "rowSpan": {
                "default": 2,
                "type": "number"
              }
            },
            "type": "object"
          },
          "header": {
            "description": "Widget header configuration",
            "properties": {
              "enabled": {
                "default": true,
                "description": "Whether the widget header should show.",
                "type": "boolean"
              },
              "style": {
                "$ref": "#/$defs/style-properties.schema"
              },
              "title": {
                "default": "",
                "description": "The header title.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "isConfigurable": {
            "default": false,
            "description": "If enabled, provides a toggle that becomes available when a widget is selected which is used to configure the widgets view. When the toggled on, the configuring view parameter will be true.",
            "type": "boolean"
          },
          "minSize": {
            "description": "This widgets minimum size used when determining widget layout.",
            "properties": {
              "columnSpan": {
                "default": 1,
                "description": "The minimum allowable columns that this widget may span.",
                "type": "number"
              },
              "rowSpan": {
                "default": 1,
                "description": "The minimum allowable rows that this widget may span.",
                "type": "number"
              }
            },
            "type": "object"
          },
          "name": {
            "default": "",
            "description": "A unique name to provide this widget.  This is used in the add widget modal.",
            "type": [
              "string",
              "number"
            ]
          },
          "style": {
            "$ref": "#/$defs/style-properties.schema"
          },
          "viewParams": {
            "default": {},
            "descriptions": "Parameters for the view. If passing parameters into the embedded view, the names here must match the parameters on that view.",
            "extension": {
              "view-params": {
                "path": "../viewPath"
              }
            },
            "type": "object"
          },
          "viewPath": {
            "default": "",
            "description": "The primary view path of the widget.",
            "format": "view-path",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "editingToggle": {
      "default": true,
      "description": "Whether to display the dashboard editing toggle.",
      "type": "boolean"
    },
    "fixed": {
      "description": "Fixed configuration used when dashboard mode is fixed.",
      "properties": {
        "cellSize": {
          "default": 100,
          "description": "Grid cell size in pixels.",
          "type": "number"
        },
        "columnCount": {
          "default": 10,
          "description": "The number of columns in the grid",
          "type": "number"
        },
        "columnGutterSize": {
          "default": 6,
          "description": "The size of the grid gaps or gutters between columns in pixels.",
          "type": "number"
        },
        "rowCount": {
          "default": 10,
          "description": "The number of rows in the grid",
          "type": "number"
        },
        "rowGutterSize": {
          "default": 6,
          "description": "The size of the grid gaps or gutters between rows in pixels.",
          "type": "number"
        }
      },
      "required": [
        "cellSize",
        "rowCount",
        "columnCount"
      ],
      "type": "object",
      "visibleWhen": {
        "equals": "fixed",
        "property": "grid"
      }
    },
    "grid": {
      "default": "stretch",
      "description": "The grids layout mode.",
      "enum": [
        "fixed",
        "stretch"
      ],
      "type": "string"
    },
    "isEditing": {
      "default": false,
      "description": "Whether the dashboard is in runtime edit mode.",
      "type": "boolean"
    },
    "pack": {
      "default": true,
      "description": "Enables widget packing algorithm. When disabled, widgets can be placed anywhere on the Dashboard and the component will not try to rearrange them in an optimal layout.",
      "type": "boolean"
