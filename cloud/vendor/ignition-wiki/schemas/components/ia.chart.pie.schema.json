            "wrap"
          ],
          "required": true,
          "type": "string"
        },
        "float": {
          "enum": [
            "none",
            "right",
            "left"
          ],
          "required": true,
          "type": "string"
        },
        "fontFamily": {
          "title": "font-family",
          "type": "string"
        },
        "fontKerning": {
          "enum": [
            "auto",
            "normal",
            "none"
