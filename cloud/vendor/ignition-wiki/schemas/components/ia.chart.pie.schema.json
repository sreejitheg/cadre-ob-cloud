  "$id": "https://ignition-wiki.local/components/ia.chart.pie.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A Pie Chart component",
  "properties": {
    "colors": {
      "description": "Colors that correspond to each pie section, respective of order in data",
      "example": [
        "#3366CC",
        "#EC4B3D",
        "#4FC86C",
        "#00A9C6",
        "#E69300"
      ],
      "items": {
        "description": "Color for a single pie section",
        "format": "color",
        "type": "string"
      },
      "type": "array"
    },
    "cutoutRadius": {
      "default": 0,
      "description": "Percent of total radius to cut out of center of chart. If greater than zero, chart becomes ring-style instead of pie.",
      "exclusiveMaximum": true,
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "data": {
      "description": "Data source for this chart. Each object within array defines the name and value for a single pie section.",
      "example": [
        {
          "count": 36,
          "flavor": "Pumpkin"
        },
        {
          "count": 17,
          "flavor": "Pecan"
        },
        {
          "count": 14,
          "flavor": "Apple"
        },
        {
          "count": 10,
          "flavor": "Sweet Potato"
        },
        {
          "count": 9,
          "flavor": "Chocolate"
        }
      ],
      "items": {
        "properties": {
          "label": {
            "description": "Name of subject of current pie section",
            "type": "string"
          },
          "value": {
            "description": "Value which determines percentage of chart current pie section occupies",
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": [
        "array",
        "dataset"
      ]
    },
    "enableTransitions": {
      "default": true,
      "description": "Whether chart has visual transition effects for changes in chart data",
      "type": "boolean"
    },
    "labels": {
      "properties": {
        "align": {
          "default": true,
          "description": "Whether the labels should be aligned in vertical columns",
          "type": "boolean",
          "visibleWhen": {
            "equals": false,
            "property": "bent"
          }
        },
        "bent": {
          "default": false,
          "description": "Bend labels around slices. Bending labels will disable the align and wrap properties",
          "type": "boolean"
        },
        "color": {
          "default": "",
          "description": "The color of the labels",
          "format": "color",
          "type": "string"
        },
        "inside": {
          "properties": {
            "color": {
              "default": "#FFFFFF",
              "description": "Label color for labels while they are displayed inside the chart",
              "format": "color",
              "type": "string"
            },
            "enabled": {
              "default": false,
              "description": "Whether the labels should show inside of the chart slices, based on if the value percentage is below the percentLimit threshold. Displaying labels inside the chart will disable bent and align properties",
              "type": "boolean"
            },
            "percentLimit": {
              "default": 10,
              "description": "Value that determines at what value percentage to place label on outside of chart instead of inside",
              "type": "number"
            },
            "radius": {
              "default": 80,
              "description": "Distance in percentage towards center of pie chart while inside is enabled. 0 represents outside edge while 100 would be directly in the middle",
              "type": "number"
            }
          },
          "type": "object"
        },
        "showName": {
          "default": true,
          "description": "Whether to show the name on the label",
          "type": "boolean"
        },
        "showValue": {
          "default": true,
          "description": "Whether to show the value on the label. Hiding values will disable any value formats set",
          "type": "boolean"
        },
        "wrap": {
          "description": "Label text wrapping configuration.",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Enables label text wrapping.",
              "type": "boolean"
            },
            "maxWidth": {
              "default": 200,
              "description": "The max allowable label width.",
              "type": "number"
            }
          },
          "type": "object",
          "visibleWhen": {
            "equals": false,
            "property": "bent"
          }
        }
      },
      "type": "object"
    },
    "legend": {
      "properties": {
        "fontSize": {
          "default": 16,
          "description": "Font size for legend labels",
          "type": "number"
        },
        "icon": {
          "properties": {
            "enabled": {
              "default": true,
              "description": "Value that determines whether to show the legend icons or hide them",
              "type": "boolean"
            },
            "height": {
              "default": 25,
              "description": "Height value of legend icon",
              "type": "number",
              "visibleWhen": {
                "equals": true,
                "property": "enabled"
              }
            },
